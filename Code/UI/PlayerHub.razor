@using Sandbox;
@using Sandbox.UI;
@using System;
@inherits PanelComponent
@namespace Sandbox

<root>
	<div class="vitals">
		<p>⏰ @GetTimeString()</p>
		<p>⭐ @Score</p>
	</div>

	<div class="healthbars">
		<div class="healthbar">
			<div class="inner">
				<div class="fill" style="width: @(Math.Ceiling(Health)/MaxHealth*100f)%"></div>
				<p>❤️ @Math.Ceiling(Health)</p>
			</div>
		</div>

		<div class="healthbar armor">
			<div class="inner">
				<div class="fill" @ref="ArmorFill"></div>
			</div>
		</div>
	</div>

	<div class="hotbar">
		@for(int i=0; i<Slots; i++)
		{
			<div class="slot @((ActiveSlot == i) ? "active" : "")">

			</div>
		}
	</div>
</root>

<style>
	PlayerHub
	{
		position: absolute;
		left: 0px;
		top: 0px;
		right: 0px;
		bottom: 0px;
		font-family: Poppins;
		font-size: 24px;

		> .vitals
		{
			position: absolute;
			top: 32px;
			left: 32px;
			font-size: 64px;
			font-weight: bold;
			text-stroke: 8px black;
			color: white;
			flex-direction: column;
		}

		> .healthbars
		{
			position: absolute;
			bottom: 32px;
			left: 32px;
			flex-direction: column;
			gap: 8px;

			> .healthbar
			{
				width: 500px;
				height: 64px;
				background-color: rgb(48, 46, 46);
				padding: 8px;

				> .inner
				{
					background-color: black;
					flex-grow: 1;

					> .fill
					{
						height: 100%;
						background-color: rgb(185, 53, 35);

					}

					> p
					{
						position: absolute;
						top: 50%;
						left: 50%;
						transform: translate(-50%, -100%);
						color: white;
						font-size: 24px;
						font-weight: bold;
					}
				}

				&.armor
				{
					height: 32px;
					> .inner
					{
						> .fill
						{
							background-color: rgb(212, 149, 54);
						}
					}
				}
			}

		}

		> .hotbar
		{
			position: absolute;
			bottom: 32px;
			width: 100%;
			z-index: 1;
			gap: 8px;
			justify-content: center;
			align-items: flex-end;

			> .slot
			{
				width: 92px;
				height: 92px;
				background-color: rgba(39, 42, 49, 0.63);
				border-radius: 16px;
				transition: all 0.1s ease;

				&.active
				{
					background-color: rgba(247, 245, 255, 0.808);
					width: 108px;
					height: 108px;
				}
			}
		}
	}
</style>

@code
{
    [Property] PlayerController Player { get; set; }

    Panel ArmorFill {get; set; }

	private Inventory Inventory =>
        Player?.Components.Get<Inventory>();

	private int Slots =>
		Inventory?.MaxInventorySlots ?? 0;

	private int ActiveSlot =>
		Inventory?.ActiveInventorySlot ?? 0;

    private PlayerStats Stats =>
        Player?.Components.Get<PlayerStats>();

    private float Health =>
        Stats?.Health ?? 0f;
    private float MaxHealth =>
        Stats?.MaxHealth ?? 0f;

    private float Armor =>
        Stats?.Armor ?? 0f;

    private float MaxArmor =>
        Stats?.MaxArmor ?? 0f;

    private int Score =>
        Stats?.GetScore() ?? 0;

    private TimeSince TimeAlive =>
        Stats?.TimeAlive ?? 0;

    string GetTimeString()
    {
        var time = TimeAlive;
        var minutes = (int) time / 60;
        var seconds = (int) time % 60;
        return $"{minutes:00}:{seconds:00}";
    }

    protected override void OnUpdate()
	{
		base.OnUpdate();

		if (ArmorFill == null)
		{
			return;
		}
		ArmorFill.Style.Width = Length.Percent(Armor/MaxArmor*100f);
    }

	protected override int BuildHash()
	{
		return System.HashCode.Combine(GetTimeString(), Score, ActiveSlot );
	}
}