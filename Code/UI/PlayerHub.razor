@using Sandbox;
@using Sandbox.UI;
@inherits PanelComponent
@namespace Sandbox

<root>
	<div class="vitals">
		<p>❤️ @Health</p>
		<p>⏰ @GetTimeString()</p>
		<p>⭐ @Score</p>
	</div>
</root>

<style>
	PlayerHub
	{
		position: absolute;
		left: 0px;
		top: 0px;
		right: 0px;
		bottom: 0px;
		font-family: Poppins;
		font-size: 24px;

		> .vitals
		{
			position: absolute;
			top: 32px;
			left: 32px;
			font-size: 64px;
			font-weight: bold;
			text-stroke: 8px black;
			color: white;
			flex-direction: column;
		}
	}
</style>

@code
{
	[Property] PlayerController Player { get; set; }

	private PlayerStats Stats =>
		Player?.Components.Get<PlayerStats>();

	private int Health =>
		Stats?.Health ?? 0;
	
	private int Score =>
		Stats?.GetScore() ?? 0;

	private TimeSince TimeAlive =>
		Stats?.TimeAlive ?? 0;

	string GetTimeString()
	{
		var time = TimeAlive;
		var minutes = (int) time / 60;
		var seconds = (int) time % 60;
		return $"{minutes:00}:{seconds:00}";
	}

	protected override int BuildHash()
	{
		return System.HashCode.Combine( Health, GetTimeString(), Score );
	}
}